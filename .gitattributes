# 统一换行符，避免 Windows/Linux 混用导致脚本在 Linux 上执行失败
* text=auto eol=lf

# Shell 脚本必须 LF，否则 Linux 上会报 "bad interpreter"
*.sh        text eol=lf
*.bash      text eol=lf

# Windows 专用
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# 二进制
*.png       binary
*.jpg       binary
*.gif       binary
*.pdf       binary
*.tar.gz    binary

# 让 GitHub 正确识别语言
*.yaml      text
*.yml       text
Dockerfile  text

# 不在 diff 中显示
*.md        diff=markdown
